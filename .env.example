# Copie para .env.local (ignorado pelo git) e preencha. Na Vercel, cadastre em Settings → Environment Variables.
# Chave gratuita em https://aistudio.google.com → Get API key. Nunca use o prefixo VITE_ (exporia a chave no navegador).
GEMINI_API_KEY=

# Opcional: modelo do Gemini. Padrão: gemini-3.6-flash (se falhar, a função tenta gemini-flash-lite-latest).
# GEMINI_MODEL=gemini-3.6-flash
